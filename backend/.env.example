# 复制为 .env 后填写自己的数据库账号
# 源码运行时放在 backend/.env；打包后的 exe 使用 %APPDATA%\背单词助手\.env
DB_HOST=127.0.0.1
DB_PORT=3306
# 推荐使用 scripts/setup_mysql.sql 创建的专用账号，而不是 root
DB_USER=vocab_app
DB_PASSWORD=
DB_NAME=vocab_assistant

# 仅开发时直连 8000 端口需要；使用 Vite 代理或同源托管时可留空
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 可选安全/边界配置 ----------
# 放在 HTTPS 反向代理后时设为 true；本地 http://127.0.0.1 保持 false
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# 上传词书 / 导入备份的大小与词数上限
MAX_UPLOAD_MB=10
MAX_IMPORT_MB=50
MAX_WORDS_PER_BOOK=20000

# 登录/注册/改密码限流（进程内滑动窗口）
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=10
PASSWORD_RATE_LIMIT=5
